{
  "cases": [
    {
      "name": "bilingual verification phrase recall",
      "setup": [
        {
          "label": "verification_phrase",
          "kind": "project_rule",
          "scope": "repo",
          "text": "本项目的验证暗号是 blue lighthouse。",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-1"
        },
        {
          "label": "unrelated_phrase",
          "kind": "session_summary",
          "scope": "session",
          "text": "昨天讨论的是 dark harbor 这个测试短语。",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-1"
        }
      ],
      "query": "blue lighthouse 是什么",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-1"
      },
      "expectedLabels": ["verification_phrase"],
      "forbiddenLabels": []
    },
    {
      "name": "repo scoped rule does not leak across repos",
      "setup": [
        {
          "label": "current_repo_rule",
          "kind": "project_rule",
          "scope": "repo",
          "text": "Basalt release checks must use curl health endpoints.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-1"
        },
        {
          "label": "other_repo_rule",
          "kind": "project_rule",
          "scope": "repo",
          "text": "Basalt release checks must use the external staging dashboard.",
          "workspaceId": "workspace-1",
          "repoId": "repo-2",
          "agentId": "agent-1",
          "sessionId": "session-2"
        }
      ],
      "query": "Basalt release checks",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-1"
      },
      "expectedLabels": ["current_repo_rule"],
      "forbiddenLabels": ["other_repo_rule"]
    },
    {
      "name": "pinned profile memory recalls preferred name without lexical overlap",
      "setup": [
        {
          "label": "preferred_name",
          "kind": "user_preference",
          "scope": "global",
          "text": "用户希望被称呼为 Rodriguez。",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-3",
          "pinned": true
        }
      ],
      "query": "how should you address me",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-4"
      },
      "expectedLabels": ["preferred_name"],
      "forbiddenLabels": []
    },
    {
      "name": "entity alias recalls project verification phrase",
      "setup": [
        {
          "label": "verification_phrase_by_alias",
          "kind": "project_rule",
          "scope": "repo",
          "text": "本项目的验证暗号是蓝色灯塔。",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-5",
          "entities": [
            {
              "text": "43130",
              "type": "identifier"
            }
          ]
        }
      ],
      "query": "43130 对应什么",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-6"
      },
      "expectedLabels": ["verification_phrase_by_alias"],
      "forbiddenLabels": []
    },
    {
      "name": "current temporal preference ranks ahead of expired preference",
      "setup": [
        {
          "label": "old_preferred_name",
          "kind": "user_preference",
          "scope": "global",
          "text": "Preferred name was Alex.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-7",
          "validUntil": 2000
        },
        {
          "label": "current_preferred_name",
          "kind": "user_preference",
          "scope": "global",
          "text": "Preferred name is Rodriguez.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-8",
          "validFrom": 2001
        }
      ],
      "query": "preferred name",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-9"
      },
      "referenceTime": 3000,
      "expectedFirstLabel": "current_preferred_name",
      "expectedLabels": ["current_preferred_name"],
      "forbiddenLabels": []
    },
    {
      "name": "historical temporal lookup can rank old preference first",
      "setup": [
        {
          "label": "old_preferred_name",
          "kind": "user_preference",
          "scope": "global",
          "text": "Preferred name was Alex.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-10",
          "validUntil": 2000
        },
        {
          "label": "future_preferred_name",
          "kind": "user_preference",
          "scope": "global",
          "text": "Preferred name is Rodriguez.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-11",
          "validFrom": 2001
        }
      ],
      "query": "preferred name",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-12"
      },
      "referenceTime": 1500,
      "expectedFirstLabel": "old_preferred_name",
      "expectedLabels": ["old_preferred_name"],
      "forbiddenLabels": []
    },
    {
      "name": "session scoped memory does not leak across sessions",
      "setup": [
        {
          "label": "session_only_note",
          "kind": "session_summary",
          "scope": "session",
          "text": "Temporary test phrase is amber vault.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-13"
        }
      ],
      "query": "amber vault",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-14"
      },
      "expectedLabels": [],
      "forbiddenLabels": ["session_only_note"]
    },
    {
      "name": "maintenance merge leaves one concise preferred name memory",
      "setup": [
        {
          "label": "preferred_name_first",
          "kind": "user_preference",
          "scope": "global",
          "text": "The user goes by Rodriguez.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-15"
        },
        {
          "label": "preferred_name_second",
          "kind": "user_preference",
          "scope": "global",
          "text": "User prefers to be called Rodriguez.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-16"
        }
      ],
      "maintenance": {
        "autoApplied": 1,
        "needsReview": 0,
        "activeCount": 1
      },
      "query": "Rodriguez",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-17"
      },
      "expectedLabels": [],
      "forbiddenLabels": ["preferred_name_first", "preferred_name_second"],
      "expectedTextContains": ["Rodriguez"]
    },
    {
      "name": "maintenance expiry removes stale timeboxed project rule",
      "setup": [
        {
          "label": "expired_launch_rule",
          "kind": "project_rule",
          "scope": "repo",
          "text": "Temporary launch rule expired yesterday.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-18",
          "validUntil": 1000
        },
        {
          "label": "current_launch_rule",
          "kind": "project_rule",
          "scope": "repo",
          "text": "Use dart format before Flutter verification.",
          "workspaceId": "workspace-1",
          "repoId": "repo-1",
          "agentId": "agent-1",
          "sessionId": "session-19",
          "validUntil": 9999999999999
        }
      ],
      "maintenance": {
        "autoApplied": 1,
        "needsReview": 0,
        "activeCount": 1
      },
      "query": "Temporary launch rule",
      "scope": {
        "workspaceId": "workspace-1",
        "repoId": "repo-1",
        "agentId": "agent-1",
        "sessionId": "session-20"
      },
      "expectedLabels": [],
      "forbiddenLabels": ["expired_launch_rule"],
      "expectedTextContains": []
    }
  ]
}
